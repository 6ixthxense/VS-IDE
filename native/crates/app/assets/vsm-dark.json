{
  "name": "VS-Monitor",
  "author": "VS-Monitor",
  "themes": [
    {
      "name": "VS-Monitor Dark",
      "mode": "dark",
      "font.size": 13,
      "mono_font.size": 13,
      "radius": 6,
      "radius.lg": 8,
      "shadow": false,
      "colors": {
        "background": "#1e1e1e",
        "foreground": "#cccccc",
        "border": "#ffffff14",
        "accent.background": "#2a2d2e",
        "accent.foreground": "#ffffff",
        "caret": "#aeafad",
        "danger.background": "#f44336",
        "danger.foreground": "#ffffff",
        "info.background": "#007acc",
        "info.foreground": "#ffffff",
        "success.background": "#4caf50",
        "success.foreground": "#ffffff",
        "warning.background": "#ff9800",
        "warning.foreground": "#1e1e1e",
        "input.border": "#ffffff1f",
        "link.foreground": "#3794ff",
        "list.background": "#252526",
        "list.active.background": "#094771",
        "list.active.border": "#007acc",
        "list.even.background": "#252526",
        "list.head.background": "#252526",
        "list.hover.background": "#2a2d2e",
        "muted.background": "#ffffff0f",
        "muted.foreground": "#858585",
        "popover.background": "#252526",
        "popover.foreground": "#cccccc",
        "primary.background": "#007acc",
        "primary.hover.background": "#1a8ad4",
        "primary.active.background": "#005a9e",
        "primary.foreground": "#ffffff",
        "ring": "#007acc",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#79797966",
        "scrollbar.thumb.hover.background": "#646464b3",
        "secondary.background": "#ffffff0f",
        "secondary.hover.background": "#ffffff1a",
        "secondary.active.background": "#ffffff26",
        "secondary.foreground": "#cccccc",
        "selection.background": "#264f78",
        "sidebar.background": "#252526",
        "sidebar.foreground": "#cccccc",
        "sidebar.border": "#ffffff14",
        "sidebar.accent.background": "#2a2d2e",
        "sidebar.accent.foreground": "#ffffff",
        "sidebar.primary.background": "#007acc",
        "sidebar.primary.foreground": "#ffffff",
        "tab.background": "#00000000",
        "tab.active.background": "#1e1e1e",
        "tab.active.foreground": "#ffffff",
        "tab.foreground": "#858585",
        "tab_bar.background": "#252526",
        "title_bar.background": "#1e1e1f",
        "title_bar.border": "#ffffff14",
        "status_bar.background": "#007acc",
        "status_bar.border": "#007acc",
        "overlay": "#00000080",
        "window.border": "#ffffff14"
      },
      "highlight": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editor.active_line.background": "#ffffff0a",
        "editor.line_number": "#858585",
        "editor.active_line_number": "#c6c6c6",
        "editor.invisible": "#ffffff1f",
        "error.border": "#f44336",
        "warning.border": "#ff9800",
        "info.border": "#007acc",
        "syntax": {
          "attribute": { "color": "#9cdcfe" },
          "boolean": { "color": "#569cd6" },
          "comment": { "color": "#6a9955", "font_style": "italic" },
          "comment.doc": { "color": "#6a9955", "font_style": "italic" },
          "constant": { "color": "#4fc1ff" },
          "constructor": { "color": "#4ec9b0" },
          "embedded": { "color": "#d4d4d4" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "function": { "color": "#dcdcaa" },
          "keyword": { "color": "#c586c0" },
          "link_text": { "color": "#3794ff" },
          "link_uri": { "color": "#ce9178" },
          "number": { "color": "#b5cea8" },
          "operator": { "color": "#d4d4d4" },
          "property": { "color": "#9cdcfe" },
          "punctuation": { "color": "#d4d4d4" },
          "punctuation.bracket": { "color": "#ffd700" },
          "punctuation.delimiter": { "color": "#d4d4d4" },
          "string": { "color": "#ce9178" },
          "string.escape": { "color": "#d7ba7d" },
          "string.regex": { "color": "#d16969" },
          "string.special": { "color": "#ce9178" },
          "tag": { "color": "#569cd6" },
          "text.literal": { "color": "#ce9178" },
          "title": { "color": "#569cd6", "font_weight": 700 },
          "type": { "color": "#4ec9b0" },
          "variable": { "color": "#9cdcfe" },
          "variable.special": { "color": "#569cd6" }
        }
      }
    }
  ]
}
