{
  "name": "vs-monitor-ide",
  "version": "2.2.0",
  "description": "A personal IDE with system monitoring — Electron + React + TypeScript",
  "author": "Mickey",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "prepare:release-config": "node scripts/prepare-release.mjs",
    "lint": "eslint src vitest.config.ts eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "dist": "npm run build && npm run prepare:release-config && electron-builder --win nsis portable",
    "dist:dir": "npm run build && npm run prepare:release-config && electron-builder --dir",
    "dist:nsis": "npm run build && npm run prepare:release-config && electron-builder --win nsis",
    "dist:portable": "npm run build && npm run prepare:release-config && electron-builder --win portable",
    "release:serve": "node scripts/serve-release.mjs dist",
    "start": "electron ."
  },
  "build": {
    "appId": "com.vsmonitor.ide",
    "productName": "VS-Monitor IDE",
    "copyright": "Copyright © 2024 Mickey",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "package.json",
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@monaco-editor/react": "^4.6.0",
    "@uiw/react-codemirror": "^4.25.8",
    "chart.js": "^4.4.3",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.44.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.33.0",
    "systeminformation": "^5.23.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.1",
    "vite": "^5.3.1",
    "vitest": "^4.1.0"
  }
}
